{
  "name": "augure",
  "version": "0.7.1",
  "description": "Augure — your proactive AI agent",
  "type": "module",
  "bin": {
    "augure": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "citty": "^0.2.1",
    "dockerode": "^4.0.9",
    "esbuild": "^0.25.0",
    "grammy": "^1.40.0",
    "imapflow": "^1.2.10",
    "nodemailer": "^6.10.1",
    "gray-matter": "^4.0.3",
    "json5": "^2.2.3",
    "node-cron": "^4.2.1",
    "zod": "^4.3.6",
    "@browserbasehq/stagehand": "^3.0.0"
  },
  "devDependencies": {
    "@augure/channels": "workspace:*",
    "@augure/core": "workspace:*",
    "@augure/memory": "workspace:*",
    "@augure/sandbox": "workspace:*",
    "@augure/scheduler": "workspace:*",
    "@augure/skills": "workspace:*",
    "@augure/tools": "workspace:*",
    "@augure/types": "workspace:*",
    "@types/dockerode": "^4.0.1",
    "@types/node-cron": "^3.0.11",
    "tsup": "^8.5.1"
  },
  "keywords": [
    "ai",
    "agent",
    "assistant",
    "telegram",
    "llm"
  ],
  "author": "Alexis",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FaureAlexis/augure.git",
    "directory": "packages/cli"
  },
  "url": "https://augure.dev",
  "publishConfig": {
    "access": "public"
  }
}
